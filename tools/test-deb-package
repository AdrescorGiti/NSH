#!/usr/bin/env bash
set -euo pipefail

if (( $# < 2 )); then
    printf 'Usage: %s /path/to/package.deb image [image ...]\n' "$0" >&2
    exit 2
fi
package=$(realpath -- "$1")
[[ -f "$package" ]]
shift
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."

container=
cleanup() {
    if [[ -n "$container" ]]; then
        docker rm -f "$container" >/dev/null
    fi
}
trap cleanup EXIT

for image in "$@"; do
    printf '\nTesting %s\n' "$image"
    container=$(docker create --network none --cap-drop ALL \
        --cap-add AUDIT_WRITE --cap-add CHOWN --cap-add DAC_OVERRIDE --cap-add FOWNER --cap-add FSETID \
        --cap-add KILL --cap-add SETGID --cap-add SETUID --cap-add SYS_CHROOT \
        "$image" /bin/sh /nsh-package-test.sh)
    docker cp "$package" "$container:/nsh.deb"
    docker cp packaging/debian/test-lifecycle.sh "$container:/nsh-package-test.sh"
    docker start -a "$container"
    [[ $(docker inspect -f '{{.State.ExitCode}}' "$container") == 0 ]]
    docker rm "$container" >/dev/null
    container=
done
